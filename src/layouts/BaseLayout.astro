---
const { pageTitle } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle || 'Tangos al bardo'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,700;1,500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #fdf6ec;
      --text: #2c1810;
      --accent: #8b0000;
      --link: #8b0000;
      --border: #d4c5a9;
      --muted: #7a6a5c;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Crimson Text', Georgia, 'Times New Roman', serif;
      font-size: clamp(1.05rem, 1.5vw, 1.25rem);
      background: var(--bg);
      color: var(--text);
      line-height: 1.85;
      max-width: min(780px, 92%);
      margin: 0 auto;
      padding: clamp(1.5rem, 3vw, 2.5rem) clamp(0.75rem, 2vw, 1.5rem);
      padding-left: clamp(3rem, 8vw, 6rem);
    }

    header {
      text-align: center;
      margin-bottom: 3.5rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--border);
    }

    header h1 {
      font-family: 'Playfair Display', 'Crimson Text', Georgia, serif;
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.03em;
      line-height: 1.2;
    }

    header h1 a { color: inherit; text-decoration: none; }

    header p {
      color: var(--muted);
      font-style: italic;
      font-size: 1.15rem;
      margin-top: 0.5rem;
    }

    nav { margin-top: 1rem; }
    nav a {
      color: var(--muted);
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.2s;
    }
    nav a:hover { color: var(--accent); text-decoration: underline; }

    main { min-height: 60vh; }

    footer {
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }

    a { color: var(--link); transition: color 0.2s; }
    a:hover { text-decoration: underline; }

    /* ---- Post detail ---- */
    article.post h2 {
      font-family: 'Playfair Display', 'Crimson Text', Georgia, serif;
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 0.4rem;
      line-height: 1.25;
    }

    article.post .meta {
      color: var(--muted);
      font-size: 1rem;
      margin-bottom: 2.5rem;
    }

    article.post .content { margin-top: 2rem; }

    article.post .content p {
      margin-bottom: 1.3rem;
    }

    article.post .content img {
      max-width: 100%;
      height: auto;
      margin: 1.5rem 0;
      display: block;
    }

    article.post .content iframe {
      max-width: 100%;
      margin: 1.5rem 0;
      display: block;
    }

    article.post .content blockquote {
      border-left: 3px solid var(--border);
      padding: 0.5rem 0 0.5rem 1.5rem;
      color: var(--muted);
      margin: 1.5rem 0;
      font-style: italic;
    }

    article.post .content hr {
      border: none;
      border-top: 1px dotted var(--border);
      margin: 2rem auto;
      max-width: 200px;
    }

    /* ---- Index listing ---- */
    .post-list { list-style: none; }

    .post-list li {
      padding: 0.9rem 0;
      border-bottom: 1px dotted var(--border);
    }

    .post-list .date {
      color: var(--muted);
      font-size: 0.9rem;
      margin-right: 0.75rem;
      white-space: nowrap;
    }

    .post-list a {
      text-decoration: none;
      color: var(--text);
      font-size: 1.15rem;
    }

    .post-list a:hover { color: var(--accent); }

    /* ---- Pagination ---- */
    .pagination {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-top: 2.5rem;
      font-size: 1.05rem;
    }

    .pagination a {
      color: var(--accent);
      text-decoration: none;
      padding: 0.4rem 1rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      transition: background 0.2s;
    }

    .pagination a:hover {
      background: var(--accent);
      color: #fff;
      text-decoration: none;
    }

    /* ---- Page heading ---- */
    .page-heading {
      font-family: 'Playfair Display', 'Crimson Text', Georgia, serif;
      font-size: 1.4rem;
      font-weight: 500;
      color: var(--accent);
      margin-bottom: 1.8rem;
    }

    /* ---- Back link ---- */
    .back-link {
      display: inline-block;
      margin-top: 3rem;
      color: var(--muted);
      font-size: 1rem;
    }

    /* ---- Responsive ---- */
    @media (max-width: 640px) {
      header h1 { font-size: 2rem; }
      article.post h2 { font-size: 1.4rem; }
      .pagination { flex-direction: column; gap: 0.5rem; align-items: center; }
    }
  </style>
</head>
<body>
  <header>
    <h1><a href="/">Tangos al bardo</a></h1>
    <p>Blog de José María Otero — tango, música y nostalgia porteña</p>
    <nav>
      <a href="/">← Inicio</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <p>Tangos al bardo — {new Date().getFullYear()} — 
      <a href="https://tangosalbardo.blogspot.com/" target="_blank" rel="noopener">Blog original</a>
    </p>
  </footer>
</body>
</html>
