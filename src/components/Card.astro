---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { getPath } from "@/utils/getPath";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, slug, data } = Astro.props;
const { title, date, tags = [] } = data;
---

<li class="my-6">
  <a
    href={getPath(id, slug)}
    class="inline-block text-lg font-medium text-skin-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
  >
    <Heading style={{ viewTransitionName: title.replace(/[^a-zA-Z0-9]+/g, "-").toLowerCase() }}>
      {title}
    </Heading>
  </a>
  <div class="mt-1">
    <Datetime date={date} />
  </div>
  {tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1">
      {tags.slice(0, 5).map((tag) => (
        <a
          href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
          class="text-xs px-2 py-0.5 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors no-underline"
        >
          {tag}
        </a>
      ))}
    </div>
  )}
</li>
