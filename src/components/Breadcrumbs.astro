---
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-skin-muted">
    <ol class="flex flex-wrap gap-x-2">
      {items.map((item: { label: string; href?: string }, i: number) => (
        <li class="flex items-center gap-x-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="hover:text-skin-accent underline-offset-4 hover:underline">
              {item.label}
            </a>
          ) : (
            <span class="text-skin-accent">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
