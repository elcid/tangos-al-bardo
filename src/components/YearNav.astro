---
import { getCollection } from "astro:content";
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL || '/';
const posts = await getCollection("posts");

const yearMap = new Map<number, number>();
for (const p of posts) {
  const year = parseInt(p.data.date.slice(0, 4));
  yearMap.set(year, (yearMap.get(year) || 0) + 1);
}
const years = [...yearMap.entries()].sort((a, b) => b[0] - a[0]);
const total = years.reduce((sum, [, c]) => sum + c, 0);
---

<aside class="mb-8 p-4 border border-skin-border rounded">
  <h2 class="text-lg font-semibold text-skin-accent mb-3">Archivo</h2>
  <p class="text-sm text-skin-muted mb-3">{total} artículos en {years.length} años</p>
  <ul class="space-y-1">
    {years.map(([year, count]) => (
      <li>
        <a
          href={`${base}archivo/${year}/`}
          class="flex justify-between text-sm hover:text-skin-accent"
        >
          <span>{year}</span>
          <span class="text-skin-muted">{count}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="mt-3 pt-3 border-t border-skin-border">
    <a href={`${base}archivo/`} class="text-sm text-skin-accent hover:underline">
      Ver archivo completo &rarr;
    </a>
  </div>
</aside>
