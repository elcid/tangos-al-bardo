---
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL || '/';

const { pathname } = Astro.url;
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  return currentPath === path || currentPath.startsWith(path + "/");
};
---

<header class="flex flex-col items-center justify-between sm:flex-row">
  <div class="py-4 sm:py-6 border-b border-skin-border relative w-full bg-skin-background flex items-baseline justify-between sm:items-center">
    <a href={base} class="text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none text-skin-accent hover:opacity-80">
      {SITE.title}
    </a>
    <nav class="flex items-center space-x-4">
      <a href={base} class:list={["font-medium hover:text-skin-accent", { "text-skin-accent": isActive("/") }]}>
        Inicio
      </a>
      <a href={`${base}posts/`} class:list={["font-medium hover:text-skin-accent", { "text-skin-accent": isActive("/posts") }]}>
        Artículos
      </a>
      <a href={`${base}tags/`} class:list={["font-medium hover:text-skin-accent", { "text-skin-accent": isActive("/tags") }]}>
        Creadores
      </a>
      <a href={`${base}archivo/`} class:list={["font-medium hover:text-skin-accent", { "text-skin-accent": currentPath.startsWith(base.slice(0, -1) + "/archivo") }]}>
        Archivo
      </a>
    </nav>
  </div>
</header>
