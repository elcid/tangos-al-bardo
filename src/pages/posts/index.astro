---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import YearNav from "@/components/YearNav.astro";
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/posts";
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL || '/';
const PAGE_SIZE = SITE.postPerPage;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
const pagePosts = sortedPosts.slice(0, PAGE_SIZE);
const page = 1;
---

<Layout
  title={`Artículos — ${SITE.title}`}
  description="Todos los artículos del blog Tangos al bardo"
>
  <h1 class="text-3xl sm:text-4xl font-bold text-skin-accent mb-8">
    Artículos
  </h1>

  <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-8">
    <div>
      <p class="text-sm text-skin-muted mb-4">
        Página 1 de {totalPages} &middot; {sortedPosts.length} artículos en total
      </p>
      <ul>
        {pagePosts.map((data) => <Card variant="h2" {...data} />)}
      </ul>

      <nav class="flex justify-center items-center gap-3 mt-12 text-sm flex-wrap">
        <span class="text-skin-muted">Pág 1 de {totalPages}</span>
        {totalPages > 1 && (
          <LinkButton
            href={`${base}posts/2/`}
            class="px-3 py-1 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors"
          >
            Siguiente &rarr;
          </LinkButton>
        )}
        {totalPages > 10 && (
          <LinkButton
            href={`${base}posts/${totalPages}/`}
            class="px-3 py-1 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors"
          >
            Última ({totalPages})
          </LinkButton>
        )}
      </nav>
    </div>
    <div class="hidden lg:block">
      <YearNav />
    </div>
  </div>
</Layout>
