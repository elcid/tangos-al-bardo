---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import Datetime from "@/components/Datetime.astro";
import { getCollection } from "astro:content";
import { getSortedPosts, getPageNumbers } from "@/utils/posts";
import { SITE } from "@/config";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);
  const pages = getPageNumbers(sortedPosts.length);

  const paths: any[] = [];

  // Post detail paths
  for (const p of sortedPosts) {
    paths.push({
      params: { slug: p.slug },
      props: { type: "post", post: p },
    });
  }

  // Paginated listing paths (pages 2, 3, ...)
  for (let i = 1; i < pages.length; i++) {
    const { start, end } = pages[i];
    paths.push({
      params: { slug: String(i + 1) },
      props: {
        type: "page",
        page: i + 1,
        totalPages: pages.length,
        posts: sortedPosts.slice(start, end),
      },
    });
  }

  return paths;
}) satisfies GetStaticPaths;

const props = Astro.props;
const isPage = props.type === "page";

// Post detail data (only used when type === "post")
let post: any;
let Content: any;
let title = "";
let date = "";
let original_url = "";
let tags: string[] = [];
let fecha = "";

if (!isPage) {
  post = props.post;
  Content = (await post.render()).Content;
  title = post.data.title;
  date = post.data.date;
  original_url = post.data.original_url;
  tags = post.data.tags || [];

  const [y, m, d] = date.split("-");
  const meses = ["enero","febrero","marzo","abril","mayo","junio",
                 "julio","agosto","septiembre","octubre","noviembre","diciembre"];
  fecha = `${parseInt(d)} de ${meses[parseInt(m)-1]} de ${y}`;
}
---

{isPage ? (
  <Layout
    title={`Artículos pág. ${props.page} — ${SITE.title}`}
    description="Todos los artículos del blog Tangos al bardo"
  >
    <section id="all-posts">
      <h1 class="text-3xl sm:text-4xl font-bold text-skin-accent mb-8">
        Página {props.page} de {props.totalPages}
      </h1>
      <ul>
        {props.posts.map((data: any) => <Card variant="h2" {...data} />)}
      </ul>
    </section>

    <nav class="flex justify-center gap-6 mt-12 text-lg">
      <LinkButton
        href={props.page === 2 ? "/posts/" : `/posts/${props.page - 1}/`}
        class="px-4 py-2 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors"
      >
        &larr; Más recientes
      </LinkButton>
      {props.page < props.totalPages && (
        <LinkButton
          href={`/posts/${props.page + 1}/`}
          class="px-4 py-2 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors"
        >
          Más antiguos &rarr;
        </LinkButton>
      )}
    </nav>
  </Layout>
) : (
  <Layout
    title={`${title} — ${SITE.title}`}
    description={`${title} — artículo del blog Tangos al bardo`}
    pubDatetime={new Date(date)}
  >
    <article class="post">
      <h1 class="text-3xl sm:text-4xl font-bold text-skin-accent mb-2">
        {title}
      </h1>
      <div class="mb-8 text-skin-muted">
        <time datetime={date}>{fecha}</time>
        {original_url && (
          <span class="ml-4">
            &middot;{" "}
            <a href={original_url} target="_blank" rel="noopener" class="hover:text-skin-accent">
              Ver original
            </a>
          </span>
        )}
      </div>
      <div class="content">
        <Content />
      </div>
      {tags.length > 0 && (
        <div class="mt-8 pt-6 border-t border-skin-border">
          <h3 class="text-sm font-semibold text-skin-muted mb-3 uppercase tracking-wide">Creadores</h3>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
                class="text-sm px-3 py-1 border border-skin-border rounded hover:bg-skin-accent hover:text-white transition-colors no-underline"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </article>

    <div class="mt-12 text-center">
      <a href="/posts/" class="text-skin-accent hover:underline">
        &larr; Volver a los artículos
      </a>
    </div>
  </Layout>
)}
