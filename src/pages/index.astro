---

import posts from '../data/posts.json';
import Layout from '../layout/Layout.astro';
import slugify from '../lib/slugify';

---

<Layout title="Tangos al bardo">
	<main class="wrapper">
		<h1>Tangos al bardo</h1>
		<ul class="post-list">
			{posts.map(p => (
				<li>
					<a href={`/posts/${slugify(p.title)}/`}>{p.title}</a>
					<time>{new Date(p.date).toLocaleDateString('es-AR')}</time>
				</li>
			))}
		</ul>
	</main>
</Layout>